# Mercado Livre OAuth (pesquisa por nome)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://localhost/callback
ML_TOKEN_SERVICE_PORT=8788
MERCADO_LIVRE_TOKEN_SERVICE_URL=http://127.0.0.1:8788/token

# Fallback manual opcional; normalmente deixe vazio e use: npm run ml:auth
MERCADO_LIVRE_ACCESS_TOKEN=

# Links afiliados do Mercado Livre — mesmos nomes usados no Auvello
AFFILIATE_MODE=portal
AFFILIATE_TAG=
AFFILIATE_CREATE_URL=https://www.mercadolivre.com.br/affiliate-program/api/v2/affiliates/createLink
ML_AFFILIATE_COOKIE=
ML_AFFILIATE_USER_AGENT=Mozilla/5.0

# Apelidos novos opcionais; se preenchidos, têm prioridade sobre os nomes acima
ML_AFFILIATE_TAG=
ML_AFFILIATE_CREATE_URL=

# Shopee Affiliate Open API
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# WhatsApp Cloud API da Meta (sem essas duas chaves, o sistema abre a mensagem pronta no WhatsApp)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
